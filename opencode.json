{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "shell": {
      "*": "allow",
      "*next build*": "ask",
      "*npm run build*": "ask",
      "*npm --prefix*build*": "ask",
      "*npx next build*": "ask",
      "*bun run build*": "ask",
      "*rm*rf*.next*": "ask",
      "*rimraf*.next*": "ask"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--caps=devtools,storage"
      ],
      "enabled": true
    },
    "openscreen": {
      "type": "local",
      "command": [
        "/Applications/Openscreen.app/Contents/MacOS/Openscreen",
        "mcp"
      ],
      "enabled": true
    }
  }
}
