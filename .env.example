DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eqindex
# Outbound email: pick a provider WITHOUT changing code, then fill only
# that provider's block. Production stays on resend.
#   resend  — Resend HTTP API. Get a key at https://resend.com/api-keys and
#             verify the MAIL_FROM domain there, or /auth/forgot returns 503.
#   smtp    — any SMTP host: Gmail app password, SendGrid, Brevo, Mailtrap.
#             All of them publish SMTP credentials on their dashboards.
#   console — dev only: print mail to the API console instead of sending.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=Boss Media <hello@bossmedia.nz>
# SMTP (only when MAIL_PROVIDER=smtp). Gmail: host smtp.gmail.com, port 587,
# user = your address, pass = 16-char app password (myaccount.google.com →
# Security → 2-Step Verification → App passwords). SendGrid: host
# smtp.sendgrid.net, port 587, user "apikey", pass = SG.* key. Brevo: host
# smtp-relay.brevo.com, port 587, user/pass from SMTP & API settings.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASS=
# Dev-only: print auth links to the API console instead of sending email
# (claim/forgot succeed without a provider). NEVER enable in production —
# the emailed link is the ownership proof for guest claims.
# DEV_MAIL_SKIP=1
# Public webshop origin, used for reset links and Stripe return URLs.
APP_URL=http://localhost:3000
# Buyer social connect (IG/FB). Issued at developers.facebook.com — never commit values.
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=https://bossmedia.nz/api/social/callback
# 32-byte hex for AES-256-GCM (generate: openssl rand -hex 32).
# SOCIAL_TOKEN_KEY=
# Community moments intake: single inbox, email-to-upload (migration 100).
# If the main domain MX is taken, use a subdomain (send@upload.bossmedia.nz) —
# only this value changes, no code.
UPLOAD_EMAIL=upload@bossmedia.nz
UPLOAD_MAX_FILES=5
UPLOAD_MAX_BYTES=20971520
# Verifies the inbound-parse webhook (provider dashboard → same value).
# INBOUND_WEBHOOK_SECRET=
