DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eqindex
# Password-reset email (Resend). Get a key at https://resend.com/api-keys and
# verify the MAIL_FROM domain there, or /auth/forgot returns 503.
RESEND_API_KEY=
MAIL_FROM=Boss Media <hello@bossmedia.nz>
# Dev-only: print auth links to the API console instead of sending email
# (claim/forgot succeed without Resend). NEVER enable in production —
# the emailed link is the ownership proof for guest claims.
# DEV_MAIL_SKIP=1
# Public webshop origin, used for reset links and Stripe return URLs.
APP_URL=http://localhost:3000
